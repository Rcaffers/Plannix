# Auth API (optional; empty uses same-origin /auth via Vite proxy in dev)
# VITE_API_BASE_URL=http://localhost:4000

# Frontend origin must match the URL you use in the browser (Stripe return URLs)
# FRONTEND_ORIGIN=http://localhost:5173

# Supabase frontend (optional, only if/when client-side Supabase is used)
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase Postgres for Express server persistence (recommended)
# Use your Supabase Postgres connection string or pooler URL
# SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# SUPABASE_POOLER_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres
# Optional fallback name
# DATABASE_URL=postgresql://...
# Optional: disable SSL for local-only DBs (keep enabled for Supabase)
# DB_SSL=true
# Optional: run SQL migrations automatically when server starts
# AUTO_RUN_MIGRATIONS=true

# Require Stripe Checkout before new accounts are created
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Set true when the site is served over HTTPS (production cookies)
# COOKIE_SECURE=true