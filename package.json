{
  "name": "plannix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node server/server.js",
    "server": "node server/server.js",
    "test:auth": "node --test src/utils/supabaseAuth.test.js src/utils/supabaseAuthController.test.js src/utils/supabaseRecovery.test.js",
    "test:frontend-auth": "node --test src/utils/supabaseAuthController.test.js",
    "test:recovery": "node --test src/utils/supabaseRecovery.test.js",
    "test:server": "node --test server/**/*.test.js",
    "test:server-auth": "node --test server/middleware/requireSupabaseAuth.test.js",
    "test:public-api": "node --test server/routes/contact-routes.test.js src/utils/publicApi.test.js",
    "test:account-deletion": "node --test server/middleware/accountDeletionRateLimit.test.js server/routes/account-routes.test.js",
    "test:frontend-account-deletion": "node --test src/utils/accountDeletion.test.js",
    "test:academic-year": "node --test src/utils/academicYear.test.js src/utils/academicYearApi.test.js",
    "test:class-placement-browser": "node scripts/test-class-placement-browser.js",
    "test:ai-connection": "node --test src/utils/aiConnectionApi.test.js server/routes/ai-connection-routes.test.js",
    "test:ai-provider-browser": "node scripts/test-ai-provider-browser.js",
    "test:classes": "node --test src/utils/classPersistence.test.js",
    "test:timetable-layout": "node --test src/utils/timetableLayoutPersistence.test.js",
    "test:timetable-sessions": "node --test src/utils/timetableSessionApi.test.js src/utils/timetableSessionState.test.js",
    "test:backup": "node --test scripts/backup-tooling.test.js",
    "secrets:check": "gitleaks detect --source . --config .gitleaks.toml --baseline-path .gitleaks-baseline.json --redact --verbose",
    "prepare": "simple-git-hooks",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "gitleaks": "^1.0.0",
    "helmet": "^8.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.2",
    "resend": "^6.12.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "simple-git-hooks": "^2.13.1",
    "supabase": "^2.115.0",
    "vite": "^8.0.9"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run secrets:check"
  }
}
